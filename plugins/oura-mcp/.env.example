# Public MCP resource identity. Keep this as an origin; /mcp is added by the service.
MCP_PUBLIC_BASE_URL=https://oura-mcp.example.com
MCP_ALLOWED_HOSTS=oura-mcp.example.com
MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com
AUTH0_ISSUER=https://your-tenant.us.auth0.com/
AUTH0_AUDIENCE=https://oura-mcp.example.com
AUTH0_SCOPE=oura:read

# Use fixture until the deployed protocol and Auth0 path are proven.
OURA_BACKEND=fixture
OURA_MAX_QUERY_DAYS=90

# Required when OURA_BACKEND=live.
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=https://oura-mcp.example.com/oauth/oura/callback
OURA_SCOPES=email personal daily heartrate workout tag session spo2Daily
OURA_TOKEN_PATH=/var/lib/oura-mcp/oauth-token.enc
OURA_TOKEN_ENCRYPTION_KEY=
OURA_STATE_SECRET=
