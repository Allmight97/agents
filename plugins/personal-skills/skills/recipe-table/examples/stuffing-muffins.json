{
  "title": "Stuffing Muffins",
  "meta": ["Makes 12 (regular 12-cup muffin tin)", "Oven 175°C"],
  "dish": {
    "step": "Bake",
    "note": "175°C, 25–35 min, until edges golden and center of largest hits 74°C. Rest 5 min before removing.",
    "inputs": [
      {"step": "Fill", "note": "cups to the top; press gently just to hold", "kind": "combine", "inputs": [
        {"step": "Moisten", "note": "add 120 mL broth; rest 10 min; add more a little at a time until it holds when squeezed, no pooling", "kind": "combine", "inputs": [
          {"step": "Pour & mix", "note": "egg mixture over bread; mix gently", "kind": "combine", "inputs": [
            {"step": "Toss", "note": "gently, in a large bowl", "inputs": [
              {"step": "Cut", "note": "2 cm cubes", "inputs": [
                {"qty": "2.8 L", "item": "slightly stale bread"}
              ]},
              {"step": "Sauté", "note": "medium-low, 10–15 min, very soft, no browning", "inputs": [
                {"step": "Melt", "note": "in skillet", "inputs": [
                  {"qty": "113 g", "item": "butter (1 stick)"}
                ]},
                {"qty": "240–360 mL", "item": "onion, diced"},
                {"qty": "475 mL", "item": "celery, diced"}
              ]}
            ]},
            {"step": "Whisk", "inputs": [
              {"qty": "3", "item": "large eggs"},
              {"qty": "120 mL", "item": "whole milk"}
            ]}
          ]},
          {"qty": "120–240 mL", "item": "chicken broth"},
          {"qty": "to taste", "item": "salt & black pepper"}
        ]},
        {"step": "Grease", "note": "12-cup muffin tin, generously", "inputs": [
          {"qty": "as needed", "item": "butter, for tin"}
        ]}
      ]}
    ]
  }
}
