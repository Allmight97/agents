#!/usr/bin/env bash
set -euo pipefail

if [[ $(uname -s) != Darwin ]]; then
  printf '%s\n' 'Clipboard token extraction currently requires macOS.' >&2
  exit 2
fi

agent_token=$(
  pbpaste |
    perl -ne 'if (/(pst_[^\s`"'\''<>]+::[^\s`"'\''<>]+)/) { print $1; exit }'
)

cleanup() {
  unset agent_token
}
trap cleanup EXIT HUP INT TERM

if [[ -z "$agent_token" ]]; then
  printf '%s\n' 'No Proton Pass access token was found in the clipboard instructions.' >&2
  exit 3
fi

printf '%s' "$agent_token" | pbcopy
printf '%s\n' 'The clipboard now contains only the Proton Pass access token.'
